# Compute Bazaar — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git!

# Application
APP_NAME="Compute Bazaar"
APP_VERSION="0.1.0"
DEBUG=true
SECRET_KEY="change-this-to-a-random-secret-key-in-production"

# Database (Week 1-6: SQLite, Week 7+: PostgreSQL)
DATABASE_URL="sqlite+aiosqlite:///./compute_bazaar.db"

# JWT Authentication
JWT_SECRET_KEY="change-this-jwt-secret-in-production"
JWT_ALGORITHM="HS256"
JWT_EXPIRY_MINUTES=1440

# Auction Configuration
AUCTION_ROUND_DURATION_SECONDS=60    # How long each bidding round lasts
AUCTION_SOLVER_METHOD="greedy"       # "greedy" | "lp" | "dp"
MAX_BIDS_PER_AGENT_PER_ROUND=5       # Prevent bid flooding

# API Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ── Groq LLM Integration (Week 2+) ──
# Get your API key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=1024
