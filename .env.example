# Compute Bazaar — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git!

# Application
APP_NAME="Compute Bazaar"
APP_VERSION="0.1.0"
DEBUG=true
SECRET_KEY="change-this-to-a-random-secret-key-in-production"

# Database
# backend/app/main.py uses SQLite via SessionLocal bound to backend/app/db/models.py
DATABASE_URL="sqlite:///./backend/compute_bazaar.db"

# JWT Authentication
JWT_SECRET_KEY="change-this-jwt-secret-in-production"
JWT_ALGORITHM="HS256"
JWT_EXPIRY_MINUTES=1440

# Auction Configuration
AUCTION_ROUND_DURATION_SECONDS=60    # How long each bidding round lasts
MAX_BIDS_PER_AGENT_PER_ROUND=5       # Prevent bid flooding

# API Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Groq LLM API Key — required for autonomous agent intelligence (Week 2+)
# Leave unset to use built-in mock mode (default for tests and benchmarks)
GROQ_API_KEY=